# ==========================================
# GeoMonitor 3D — Environment Variables
# ==========================================

# Server & Application
NODE_ENV=development
API_PORT=4000
WEB_PORT=3000
API_BASE_URL=http://localhost:4000/api/v1
WEB_BASE_URL=http://localhost:3000

# Security & JWT Auth
JWT_SECRET=super-secret-geomonitor-key-change-in-production-min32chars
JWT_ACCESS_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d
COOKIE_SECRET=geomonitor-secure-cookie-secret-key-32chars

# Database (PostgreSQL + PostGIS)
DB_HOST=localhost
DB_PORT=5432
DB_USER=geomonitor
DB_PASSWORD=geomonitor_secret
DB_NAME=geomonitor
DATABASE_URL=postgresql://geomonitor:geomonitor_secret@localhost:5432/geomonitor

# Redis & BullMQ
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# MinIO / S3 Object Storage
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_BUCKET_ASSETS=geomonitor-assets
MINIO_BUCKET_REPORTS=geomonitor-reports
S3_PUBLIC_URL=http://localhost:9000

# CesiumJS Configuration
# Optional: Set Cesium Ion Access Token if using Cesium Ion World Terrain/Photogrammetry tiles.
# Fallback local ellipsoid/terrain & OpenStreetMap are configured if left empty.
NEXT_PUBLIC_CESIUM_ION_TOKEN=
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
